# JWT & Auth
SECRET_KEY=change-this-to-a-random-secret-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=15
DEACTIVATION_GRACE_PERIOD_DAYS=30

# SMTP / Email Delivery
MAIL_FROM=
MAIL_PORT=465
SMTP_SERVER=smtp.gmail.com
SMTP_USERNAME=
SMTP_PASSWORD=

# Database — DB_HOST must match the service name in docker-compose.yml
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-this-password
DB_NAME=coffee_shop

# Initial Admin Account
ADMIN_EMAIL=admin@coffeeshop.local
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Administrator

# CORS
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:63342,http://127.0.0.1:63342
